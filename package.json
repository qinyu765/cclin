{
  "name": "@hflin/cclin",
  "version": "0.11.0",
  "description": "A production-grade CLI Code Agent",
  "type": "module",
  "bin": {
    "cclin": "dist/index.js"
  },
  "files": [
    "dist",
    "src/runtime/prompt.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc && node -e \"const fs=require('fs');const p=require('path');fs.mkdirSync(p.join('dist','runtime'),{recursive:true});fs.copyFileSync(p.join('src','runtime','prompt.md'),p.join('dist','runtime','prompt.md'))\"",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.90.0",
    "@google/generative-ai": "^0.24.1",
    "@modelcontextprotocol/sdk": "^1.28.0",
    "gpt-tokenizer": "^3.4.0",
    "ink": "^6.8.0",
    "ink-text-input": "^6.0.0",
    "openai": "^4.78.1",
    "react": "^19.2.4",
    "smol-toml": "^1.6.1",
    "unicode-animations": "^1.0.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/react": "^19.2.14",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^4.1.2"
  },
  "packageManager": "pnpm@10.26.2+sha512.0e308ff2005fc7410366f154f625f6631ab2b16b1d2e70238444dd6ae9d630a8482d92a451144debc492416896ed16f7b114a86ec68b8404b2443869e68ffda6"
}
